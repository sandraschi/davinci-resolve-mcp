{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "mcpServers": {
    "davinci-resolve-mcp": {
      "command": "python",
      "args": ["run_mcp.py"],
      "cwd": "${workspaceFolder}/davinci-resolve-mcp",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/davinci-resolve-mcp/src",
        "PYTHONUNBUFFERED": "1"
      },
      "description": "FastMCP 3.x MCP server for professional DaVinci Resolve video editing automation. 9 portmanteau tools (resolve_project/media/timeline/color/render/audio/fairlight/subtitle/system) plus help/status/agentic tools for project management, media operations, timeline editing, color grading, rendering, and audio processing.",
      "capabilities": {
        "tools": {
          "enabled": true
        },
        "resources": {
          "enabled": false
        },
        "prompts": {
          "enabled": false
        }
      },
      "timeout": {
        "initialize": 30000,
        "message": 60000
      },
      "metadata": {
        "version": "0.1.0",
        "author": "sandraschi",
        "homepage": "https://github.com/sandraschi/davinci-resolve-mcp",
        "license": "MIT",
        "tags": [
          "davinci-resolve",
          "video-editing",
          "video",
          "editing",
          "automation",
          "color-grading",
          "rendering",
          "mcp-server",
          "fastmcp"
        ],
        "categories": [
          "video-editing",
          "automation",
          "professional-tools"
        ]
      }
    }
  },
  "maintainers": ["sandraschi"],
  "name": "davinci-resolve-mcp",
  "description": "FastMCP 3.x MCP server for professional DaVinci Resolve video editing automation. 9 portmanteau tools plus help/status/agentic tools for complete video production workflows. Beta status.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 3.4.4+",
  "tools": 15,
  "transport": ["stdio"],
  "keywords": [
    "davinci-resolve",
    "video-editing",
    "video",
    "editing",
    "automation",
    "color-grading",
    "rendering",
    "mcp-server",
    "fastmcp"
  ],
  "features": {
    "video_editing": {
      "enabled": true,
      "capabilities": ["project_management", "timeline_editing", "media_organization"]
    },
    "color_grading": {
      "enabled": true,
      "capabilities": ["lut_application", "color_wheels", "node_management"]
    },
    "rendering": {
      "enabled": true,
      "capabilities": ["batch_rendering", "progress_monitoring", "multi_format_export"]
    },
    "audio_processing": {
      "enabled": true,
      "capabilities": ["level_adjustment", "effects", "sync"]
    },
    "workflow_automation": {
      "enabled": true
    }
  }
}
