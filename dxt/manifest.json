{
  "manifest_version": "0.2",
  "name": "davinci-resolve-mcp",
  "version": "0.1.0",
  "description": "DaVinci Resolve MCP server for AI-assisted video editing",
  "author": {
    "name": "sandraschi"
  },
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "davinci_resolve_mcp/server.py",
    "mcp_config": {
      "command": "python",
      "args": ["-m", "davinci_resolve_mcp.server"],
      "env": {
        "PYTHONPATH": ".",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
